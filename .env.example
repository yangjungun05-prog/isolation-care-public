# 이 파일을 .env 로 복사해 값을 채운다. .env 는 git 에 올라가지 않는다.
GEMINI_API_KEY=
DATABASE_URL=postgresql+psycopg://user:1234@localhost:5432/AgentDB
DATA_GO_KR_SERVICE_KEY=
# AI 비서(src/assistant)의 안내 데스크 · 답 쓰기 · 동 상황 문서(Claude)
ANTHROPIC_API_KEY=
# 서울 열린데이터광장 키 — 강남 주민센터 · 노인복지관
SEOUL_OPEN_API=
# 비서의 오늘(진짜 오늘이 live). 날짜(YYYY-MM-DD)를 넣으면 그날까지의 관측으로 되감는다
AS_OF=live
